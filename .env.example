# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# O .env não é versionado (está no .gitignore).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pauta
POSTGRES_PORT=5432

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=16543

# Atenção: o pgadmin/servers.json usa o usuário "postgres" e o banco "pauta".
# Se mudar POSTGRES_USER ou POSTGRES_DB, ajuste também esse arquivo.
